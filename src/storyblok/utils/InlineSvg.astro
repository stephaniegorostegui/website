---
const { src, class: classList, innerclass } = Astro.props

// Fail silently: a deleted Storyblok asset (404, non-SVG, network error)
// must never break the whole page. Render nothing in those cases.
let innerHTML = ''
try {
  if (typeof src === 'string' && src.trim() !== '') {
    const res = await fetch(src)
    const contentType = res.headers.get('content-type') ?? ''
    if (res.ok) {
      const text = await res.text()
      const trimmed = text.trim()
      // Only inline actual SVG content, otherwise ignore (e.g. Storyblok 404 HTML page)
      if (trimmed.includes('<svg') && (contentType.includes('svg') || trimmed.startsWith('<svg'))) {
        innerHTML = text.replace('<svg', `<svg class="${innerclass ?? ''}"`)
      }
    }
  }
} catch {
  innerHTML = ''
}
---

{innerHTML && <div class={`fill-current stroke-current ${classList ? classList : ''}`}><Fragment set:html={innerHTML} /></div>}

<style>
  div > :global(svg) {
    max-width: 100%;
    max-height: 100%;
  }
</style>
